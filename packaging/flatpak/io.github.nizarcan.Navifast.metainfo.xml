<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nizarcan.Navifast</id>
  <name>Navifast</name>
  <summary>A native Navidrome client</summary>
  <developer id="io.github.nizarcan">
    <name>Navifast contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>A native desktop client for your Navidrome music library, written in Rust.</p>
    <p>Browse albums and play original audio locally with transport controls,
    an equalizer and spectrum display. This is an early migration build.</p>
  </description>
  <launchable type="desktop-id">io.github.nizarcan.Navifast.desktop</launchable>
  <url type="homepage">https://github.com/nizarcan/navifast/</url>
  <url type="bugtracker">https://github.com/nizarcan/navifast/issues</url>
  <url type="help">https://github.com/nizarcan/navifast/blob/main/docs/_guide/getting-started.md</url>
  <url type="vcs-browser">https://github.com/nizarcan/navifast</url>
  <branding>
    <color type="primary" scheme_preference="light">#76b9ff</color>
    <color type="primary" scheme_preference="dark">#7565d9</color>
  </branding>
  <content_rating type="oars-1.1" />
  <requires>
    <display_length compare="ge">760</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <releases>
    <release version="0.1.0-rc.2" date="2026-11-07" type="development">
      <description><p>Browse and play the playlists available on your Navidrome account.</p></description>
    </release>
    <release version="0.1.0-rc.1" date="2026-11-05" type="development">
      <description>
        <p>First Navifast release candidate, with Navidrome sign-in, album browsing,
        original-audio playback, an equalizer, and buffered streaming.</p>
      </description>
    </release>
  </releases>
</component>
